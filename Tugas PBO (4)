
#===========================================Class Vehicle===========================================
class Vehicle:
    def __init__(self, brand, model):
        if not brand or brand.strip() == "":
            raise ValueError("Brand cannot be empty")
        if not model or model.strip() == "":
            raise ValueError("Model cannot be empty!")
        self.brand = brand
        self.model = model

    def drive(self):
        print(f"The {self.brand} {self.model} is driving.")

#===========================================Class Car===========================================
class Car(Vehicle):
    def __init__(self, brand, model, doors):
        super().__init__(brand, model)
        if doors <= 0:
            raise ValueError("The number of doors must be greater than 0!")
        elif doors > 6: #6 ini hanya untuk contoh maksimal dari jumlah pintu yang masuk akal
            raise ValueError(f"The number of doors ({doors}) is unrealistic for a standard car!")
        self.doors = doors
    
    def honk(self):
        print("Beep! Beep!")

#===========================================Class Truck===========================================
class Truck(Vehicle):
    def __init__(self, brand, model, load_capacity):
        super().__init__(brand, model)
        if load_capacity <= 0:
            raise ValueError("The number of load capacity must be greater than 0!")
        self.load_capacity = load_capacity

    def load(self, weight):
        if weight > self.load_capacity:
            raise ValueError(f"Overload! Capacity is {self.load_capacity} kg, but loaded {weight} kg.")
        print(f"Loaded {weight} kg.")


def main():
    try:
        my_car = Car("Toyota", "Corolla", 4)
        my_truck = Truck("Ford", "F-150", 1000)

        my_car.drive()
        my_car.honk()

        my_truck.drive()
        my_truck.load(1200) #error gk masuk akal 1200 kg
    except ValueError as e:
        print(f"Warning: {e}")

if __name__ == "__main__":
    main()